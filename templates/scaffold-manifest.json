      "purpose": "skill usage and VS Code chat syntax guide",
      "requires": "always"
    },
    {
      "path": ".github/prompts/project-blueprint.prompt.md",
      "kind": "prompt",
      "purpose": "versioned project requirements and delivery blueprint",
      "requires": "always"
    },
    {
      "path": ".github/prompts/project-start.prompt.md",
      "kind": "prompt",
      "purpose": "start a governed project lifecycle from its blueprint",
      "requires": "always"
    },
    {
      "path": ".github/prompts/project-validate.prompt.md",
      "kind": "prompt",
      "purpose": "validate project foundation before implementation",
      "requires": "always"
    },
    {
      "path": "infra/deploy.ps1",
      "kind": "deployment",
      "purpose": "azure deployment orchestrator entry point",
      "requires": "always",
      "createOnly": true
    },
    {
      "path": "infra/discover.ps1",
      "kind": "deployment",
      "purpose": "azure region service and model discovery",
      "requires": "always",
      "createOnly": true
    },
    {
      "path": "infra/azure-environment.ps1",
      "kind": "deployment",
      "purpose": "persisted azure cloud subscription authentication and mcp profile",
