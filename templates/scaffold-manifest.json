{
  "schemaVersion": "1.0.0",
  "description": "Declares which project scaffold templates apply to a target repository. 'requires' lists stack tags; a template installs when any listed tag is detected or declared. 'always' templates install unconditionally. 'createOnly' templates are never added to an existing repository during adoption.",
  "templates": [
    {
      "path": ".skills-orchestrator/live-chat/conversation-state.mjs",
      "kind": "local-runtime",
      "purpose": "provider-neutral conversation state machine",
      "requires": "always"
    },
    {
      "path": ".skills-orchestrator/live-chat/grounding.mjs",
      "kind": "local-runtime",
      "purpose": "approved local grounding and citation validation",
      "requires": "always"
    },
    {
      "path": ".skills-orchestrator/live-chat/local-session.mjs",
      "kind": "local-runtime",
      "purpose": "credential-free local session and transport boundary",
      "requires": "always"
    },
    {
      "path": ".skills-orchestrator/live-chat/evaluation.mjs",
      "kind": "local-runtime",
      "purpose": "deterministic endpoint and local latency evaluation helpers",
      "requires": "always"
    },
    {
      "path": ".skills-orchestrator/live-chat/server/provider-adapter.mjs",
      "kind": "local-runtime",
      "purpose": "server-only Azure Government provider compatibility and streaming adapter",
      "requires": "always"
    },
    {
      "path": ".skills-orchestrator/live-chat/browser-controller.mjs",
      "kind": "local-runtime",
      "purpose": "browser permission cancellation and fallback controller",
      "requires": "always"
    },
    {
      "path": ".skills-orchestrator/live-chat/browser-panel.html",
      "kind": "local-runtime",
      "purpose": "accessible live chat browser panel",
      "requires": "always"
    },
    {
      "path": ".skills-orchestrator/live-chat/browser.css",
      "kind": "local-runtime",
      "purpose": "accessible responsive live chat styling",
      "requires": "always"
    },
    {
      "path": ".editorconfig",
      "kind": "workspace-support",
      "purpose": "editor formatting baseline",
      "requires": "always"
    },
    {
      "path": ".gitattributes",
      "kind": "workspace-support",
      "purpose": "line ending normalization",
      "requires": "always"
    },
    {
      "path": ".vscode/mcp.json",
      "kind": "workspace-support",
      "purpose": "model context protocol servers",
      "requires": "always"
    },
    {
      "path": "docs/adr/0000-template.md",
      "kind": "documentation",
      "purpose": "architecture decision record template",
      "requires": "always"
    },
    {
      "path": "docs/README.md",
      "kind": "documentation",
      "purpose": "documentation index",
      "requires": "always",
      "createOnly": true
    },
    {
      "path": ".github/copilot-instructions.md",
      "kind": "instructions",
      "purpose": "repository instructions",
      "requires": "always",
      "createOnly": true
    },
    {
      "path": ".github/instructions/clarification.instructions.md",
      "kind": "scoped-instructions",
      "purpose": "clarification protocol questions before work",
      "applyTo": "**",
      "requires": "always",
      "mandatory": true
    },
    {
      "path": ".github/instructions/security.instructions.md",
      "kind": "scoped-instructions",
      "purpose": "security secrets identity injection owasp",
      "applyTo": "**",
      "requires": "always"
    },
    {
      "path": ".github/instructions/markdown.instructions.md",
      "kind": "scoped-instructions",
      "purpose": "markdown documentation writing",
      "applyTo": "**/*.md",
      "requires": "always"
    },
    {
      "path": ".github/instructions/tests.instructions.md",
      "kind": "scoped-instructions",
      "purpose": "automated test authoring",
      "applyTo": "**/tests/**,**/test/**,**/*.test.*,**/*.spec.*,**/*Tests.cs",
      "requires": ["tests"]
    },
    {
      "path": ".github/instructions/typescript.instructions.md",
      "kind": "scoped-instructions",
      "purpose": "typescript javascript authoring",
      "applyTo": "**/*.ts,**/*.tsx,**/*.js,**/*.mjs,**/*.cjs",
      "requires": ["typescript", "javascript"]
    },
    {
      "path": ".github/instructions/csharp.instructions.md",
      "kind": "scoped-instructions",
      "purpose": "csharp dotnet authoring",
      "applyTo": "**/*.cs",
      "requires": ["csharp"]
    },
    {
      "path": ".github/instructions/powershell.instructions.md",
      "kind": "scoped-instructions",
      "purpose": "powershell scripting",
      "applyTo": "**/*.ps1,**/*.psm1,**/*.psd1",
      "requires": ["powershell"]
    },
    {
      "path": ".github/instructions/bicep.instructions.md",
      "kind": "scoped-instructions",
      "purpose": "bicep azure infrastructure as code",
      "applyTo": "**/*.bicep,**/*.bicepparam",
      "requires": ["bicep"]
    },
    {
      "path": ".github/instructions/azure-deployment.instructions.md",
      "kind": "scoped-instructions",
      "purpose": "azure deployment discovery managed identity sovereign cloud",
      "applyTo": "infra/**",
      "requires": "always"
    },
    {
      "path": ".github/prompts/skills-help.prompt.md",
