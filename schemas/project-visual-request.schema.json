{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills-orchestrator.local/schemas/project-visual-request.schema.json",
  "title": "Project Visual Storytelling Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "source", "visual", "destination", "rendering"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "runId": { "type": "string", "pattern": "^[A-Za-z0-9-]{20,180}$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "repositoryDigestSha256", "projectUnderstandingDigestSha256"],
      "properties": {
        "kind": { "const": "current-project" },
        "repositoryDigestSha256": { "$ref": "#/$defs/sha256" },
        "projectUnderstandingDigestSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "audience", "state", "detail", "formats"],
      "properties": {
        "type": { "enum": ["architecture", "component", "deployment", "data-flow", "sequence", "process", "agent-topology", "executive-overview", "whiteboard", "diorama"] },
        "audience": { "enum": ["executive", "business", "technical", "developer", "operations", "security"] },
        "state": { "enum": ["current", "future", "comparison"] },
        "detail": { "enum": ["low", "medium", "high"] },
        "formats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["mmd", "svg", "png", "spec"] }
        }
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directory"],
      "properties": {
        "directory": { "type": "string", "pattern": "^artifacts/project-visual-storytelling/[A-Za-z0-9-]+$" }
      }
    },
    "rendering": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedClasses"],
      "properties": {
        "allowedClasses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["deterministic-source", "deterministic-vector", "bitmap-generation", "physically-based-3d"] }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}