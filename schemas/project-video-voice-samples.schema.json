{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills-orchestrator.local/schemas/project-video-voice-samples.schema.json",
  "title": "Project Video Voice Samples",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "planSha256", "scene", "sampleText", "sampleTextSha256", "auditionPageSha256", "cloud", "region", "recommended", "samples"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "planSha256": { "$ref": "#/$defs/sha256" },
    "scene": { "type": "string", "pattern": "^scene-[0-9]{2}$" },
    "sampleText": { "type": "string", "minLength": 20, "maxLength": 420 },
    "sampleTextSha256": { "$ref": "#/$defs/sha256" },
    "auditionPageSha256": { "$ref": "#/$defs/sha256" },
    "cloud": { "enum": ["AzureCloud", "AzureUSGovernment"] },
    "region": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "azureDiscoverySha256": { "$ref": "#/$defs/sha256" },
    "azureDiscoveryAt": { "type": "string", "format": "date-time" },
    "recommended": { "const": "ava-hd-warm" },
    "samples": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "slot", "label", "file", "voice", "sha256"],
        "properties": {
          "id": { "enum": ["ava-hd-warm", "aria-hd-warm", "jenny-professional", "aria-professional"], "description": "Current A/B/C profiles use Jenny for C; aria-professional remains readable historical evidence and requires re-audition before new selection or synthesis." },
          "slot": { "enum": ["A", "B", "C"] },
          "label": { "type": "string", "minLength": 1, "maxLength": 120 },
          "file": { "type": "string", "pattern": "^(ava-hd-warm|aria-hd-warm|jenny-professional|aria-professional)\\.mp3$" },
          "voice": { "$ref": "#/$defs/voice" },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "locale", "style", "styleDegree", "ratePercent", "sentencePauseMs"],
      "properties": {
        "provider": { "const": "azure-neural" },
        "name": { "type": "string", "pattern": "^[A-Za-z0-9-]+(?::[A-Za-z0-9-]+)?Neural$" },
        "locale": { "const": "en-US" },
        "style": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$" },
        "styleDegree": { "type": "number", "minimum": 0.01, "maximum": 2 },
        "ratePercent": { "type": "integer", "minimum": -20, "maximum": 20 },
        "sentencePauseMs": { "type": "integer", "minimum": 0, "maximum": 1000 }
      }
    }
  }
}