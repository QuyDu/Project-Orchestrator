{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-skills.dev/schemas/agent-provider-capabilities/1.0.0",
  "title": "Agent Provider Capabilities",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "registryVersion", "reviewedOn", "providers"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "registryVersion": { "const": "2026-09-22.1" },
    "reviewedOn": { "const": "2026-09-22" },
    "providers": {
      "type": "array", "minItems": 7, "maxItems": 7,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "target", "runtime", "support", "clouds", "apiVersion", "executable", "automaticSteps", "manualSteps", "limitations", "sources"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,79}$" },
          "target": { "$ref": "agent-deployment-request.schema.json#/$defs/target" },
          "runtime": { "enum": ["prompt", "hosted", "package"] },
          "support": { "enum": ["supported", "preview", "manual", "unavailable"] },
          "clouds": { "type": "array", "maxItems": 2, "uniqueItems": true, "items": { "enum": ["AzureCloud", "none"] } },
          "apiVersion": { "type": ["string", "null"], "maxLength": 32 },
          "executable": { "type": "boolean" },
          "automaticSteps": { "$ref": "agent-deployment-plan.schema.json#/$defs/strings" },
          "manualSteps": { "$ref": "agent-deployment-plan.schema.json#/$defs/strings" },
          "limitations": { "$ref": "agent-deployment-plan.schema.json#/$defs/strings" },
          "sources": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "format": "uri", "pattern": "^https://(?:learn\\.microsoft\\.com|platform\\.openai\\.com|developers\\.openai\\.com|help\\.openai\\.com|raw\\.githubusercontent\\.com)/" } }
        }
      }
    }
  }
}
