    ]},
    "microsoft365": {
      "type": "object", "additionalProperties": false,
      "required": ["projectEndpoint", "apiVersion", "location", "agentVersion", "definitionSha256", "testEvidence", "bot", "publishScope", "appVersion", "agentDisplayName", "shortDescription", "fullDescription", "developerName", "developerWebsiteUrl", "privacyUrl", "termsOfUseUrl", "enableM365PublicEndpoint", "dataFlowReviewed", "workspacePolicyReviewed"],
      "properties": {
        "projectEndpoint": { "type": "string", "maxLength": 256, "pattern": "^https://[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.services\\.ai\\.azure\\.com/api/projects/[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$" },
        "apiVersion": { "const": "v1" },
        "location": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
        "agentVersion": { "$ref": "#/$defs/version" },
        "definitionSha256": { "$ref": "#/$defs/sha256" },
        "testEvidence": { "$ref": "#/$defs/file" },
        "bot": {
          "type": "object", "additionalProperties": false, "required": ["resourceGroup", "name", "mode"],
          "properties": {
            "resourceGroup": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$" },
            "name": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{1,63}$" },
            "mode": { "enum": ["existing", "create-or-verify"] }
          }
        },
        "publishScope": { "enum": ["Shared", "Personal", "Tenant"] },
        "appVersion": { "type": "string", "pattern": "^[0-9]{1,5}\\.[0-9]{1,5}\\.[0-9]{1,5}$" },
        "agentDisplayName": { "type": "string", "minLength": 3, "maxLength": 30 },
        "shortDescription": { "type": "string", "minLength": 10, "maxLength": 80 },
        "fullDescription": { "type": "string", "minLength": 20, "maxLength": 4000 },
        "developerName": { "type": "string", "minLength": 1, "maxLength": 32 },
        "developerWebsiteUrl": { "$ref": "#/$defs/publicUrl" },
        "privacyUrl": { "$ref": "#/$defs/publicUrl" },
        "termsOfUseUrl": { "$ref": "#/$defs/publicUrl" },
        "enableM365PublicEndpoint": { "type": "boolean" },
        "provisioningTimeoutSeconds": { "type": "integer", "minimum": 30, "maximum": 900 },
        "dataFlowReviewed": { "const": true },
        "workspacePolicyReviewed": { "const": true }
      }
    },
    "publicUrl": {
      "type": "string", "maxLength": 1024,
      "pattern": "^https://(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\\.)+[a-z]{2,63}(?:/[a-zA-Z0-9._~/-]*)?$"
    },
    "publicationTestEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "projectEndpoint", "agentName", "version", "definitionSha256", "blueprintSha256", "verifiedAt", "expiresAt", "passed", "probeResponseSha256"],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "projectEndpoint": { "type": "string", "maxLength": 256, "pattern": "^https://[a-z0-9-]+\\.services\\.ai\\.azure\\.com/api/projects/[a-zA-Z0-9_-]+$" },
        "agentName": { "type": "string", "maxLength": 63, "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
        "version": { "$ref": "#/$defs/version" },
        "definitionSha256": { "$ref": "#/$defs/sha256" },
        "blueprintSha256": { "$ref": "#/$defs/sha256" },
        "verifiedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "passed": { "const": true },
        "probeResponseSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "endpointAllowlist": {
      "type": "object", "additionalProperties": false, "required": ["schemaVersion", "cloud", "projectEndpoints"],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "cloud": { "const": "AzureCloud" },
        "projectEndpoints": {
          "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
          "items": { "type": "string", "maxLength": 256, "pattern": "^https://[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.services\\.ai\\.azure\\.com/api/projects/[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$" }
        },
        "containerRegistries": {
          "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*\\.azurecr\\.io$" }
        },
        "botResourceGroups": {
          "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$" }
        }
      }
    },
    "hostedTestEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "agentName", "version", "image", "blueprintSha256", "verifiedAt", "expiresAt", "passed", "probeResponseSha256"],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "agentName": { "type": "string", "maxLength": 63, "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
        "version": { "$ref": "#/$defs/version" },
        "image": { "type": "string", "maxLength": 512, "pattern": "^[a-z0-9.-]+\\.azurecr\\.io/[a-z0-9._/-]+@sha256:[a-f0-9]{64}$" },
        "blueprintSha256": { "$ref": "#/$defs/sha256" },
        "verifiedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "passed": { "const": true },
        "probeResponseSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "path": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?![\\\\/])(?!.*[\\\\/]$)(?!.*[\\\\/]{2})(?!.*(?:^|[\\\\/])\\.{1,2}(?:[\\\\/]|$))(?!.*[. ](?:[\\\\/]|$))(?!.*(?:^|[\\\\/])(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][0-9]|[Ll][Pp][Tt][0-9])(?:\\.|[\\\\/]|$))[a-zA-Z0-9._ /\\\\-]+$" },
    "version": { "type": "string", "pattern": "^[1-9][0-9]{0,15}$" },
    "file": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": { "path": { "$ref": "#/$defs/path" }, "sha256": { "$ref": "#/$defs/sha256" } }
    },
    "target": { "enum": ["foundry-endpoint", "microsoft-365-copilot-and-teams", "microsoft-365-agents-toolkit", "copilot-studio", "openai-api-application", "chatgpt-action-handoff"] }
  }
}
