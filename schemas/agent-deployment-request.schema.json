{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-skills.dev/schemas/agent-deployment-request/1.0.0",
  "title": "Agent Deployment Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "blueprint", "target", "release", "mode", "cloud", "environment", "audience", "data", "runtime", "verification", "rollback", "acceptPreview"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "blueprint": { "$ref": "#/$defs/file" },
    "target": { "$ref": "#/$defs/target" },
    "release": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$" },
    "mode": { "enum": ["create", "update", "promote", "rollback"] },
    "cloud": { "enum": ["AzureCloud", "AzureUSGovernment", "none"] },
    "environment": { "enum": ["development", "staging", "production"] },
    "audience": { "enum": ["individual", "tenant", "workspace", "link", "gpt-store", "private"] },
    "data": {
      "type": "object", "additionalProperties": false,
      "required": ["classification", "boundary", "residency"],
      "properties": {
        "classification": { "enum": ["public", "internal", "confidential", "restricted"] },
        "boundary": { "enum": ["project-local", "organization", "external"] },
        "residency": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" } }
      }
    },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "tools", "acknowledgeLocalCapabilitiesOmitted"],
      "properties": {
        "kind": { "enum": ["prompt", "hosted", "application"] },
        "tools": { "type": "array", "maxItems": 0 },
        "acknowledgeLocalCapabilitiesOmitted": { "const": true }
      }
    },
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["prompt", "expectedSubstring", "maxOutputTokens"],
      "properties": {
        "prompt": { "type": "string", "minLength": 1, "maxLength": 512 },
        "expectedSubstring": { "type": "string", "minLength": 1, "maxLength": 256 },
        "maxOutputTokens": { "type": "integer", "minimum": 16, "maximum": 256 }
      }
    },
    "rollback": {
      "type": "object", "additionalProperties": false, "required": ["strategy", "version"],
      "properties": {
        "strategy": { "enum": ["repin", "manual"] },
        "version": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/version" }] }
      }
    },
    "acceptPreview": { "type": "boolean" },
    "microsoft365": { "$ref": "#/$defs/microsoft365" },
    "copilotStudio": { "$ref": "#/$defs/copilotStudio" },
    "agentsToolkit": { "$ref": "#/$defs/agentsToolkit" },
    "foundry": {
      "type": "object", "additionalProperties": false,
      "required": ["projectEndpoint", "apiVersion", "location", "versionPolicy", "protocols", "authorization", "quotaReviewed", "costReviewed"],
      "properties": {
        "projectEndpoint": { "type": "string", "maxLength": 256, "pattern": "^https://[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.services\\.ai\\.azure\\.com/api/projects/[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$" },
        "apiVersion": { "const": "v1" },
        "modelDeployment": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$" },
        "location": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
        "versionPolicy": { "const": "pinned" },
        "protocols": { "const": ["responses"] },
        "authorization": { "const": "Entra" },
        "quotaReviewed": { "const": true },
        "costReviewed": { "const": true },
        "promoteVersion": { "$ref": "#/$defs/version" }
      }
    },
    "hosted": {
      "type": "object", "additionalProperties": false,
      "required": ["image", "sbom", "testedAgentName", "testedVersion", "testEvidence", "cpu", "memory", "protocolVersion", "idleTimeoutSeconds", "startupTimeoutSeconds", "codeReviewed", "imageProvenanceReviewed"],
      "properties": {
        "image": { "type": "string", "maxLength": 512, "pattern": "^[a-z0-9.-]+\\.azurecr\\.io/[a-z0-9._/-]+@sha256:[a-f0-9]{64}$" },
        "sbom": { "$ref": "#/$defs/file" },
        "testedVersion": { "$ref": "#/$defs/version" },
        "testedAgentName": { "type": "string", "maxLength": 63, "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
        "testEvidence": { "$ref": "#/$defs/file" },
        "cpu": { "enum": ["0.5", "1", "2", "4"] },
        "memory": { "enum": ["1Gi", "2Gi", "4Gi", "8Gi"] },
        "protocolVersion": { "const": "2.0.0" },
        "idleTimeoutSeconds": { "type": "integer", "minimum": 60, "maximum": 3600 },
        "startupTimeoutSeconds": { "type": "integer", "minimum": 30, "maximum": 900 },
        "registryConnectionId": { "type": "string", "maxLength": 256, "pattern": "^/?[a-zA-Z0-9][a-zA-Z0-9._/-]*$" },
        "codeReviewed": { "const": true },
        "imageProvenanceReviewed": { "const": true }
      }
    },
    "openai": {
      "type": "object", "additionalProperties": false, "required": ["model"],
      "properties": { "model": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$" } }
    },
    "chatgpt": {
      "type": "object", "additionalProperties": false,
      "required": ["openApi", "allowedHosts", "authentication", "workspacePolicyReviewed", "dataFlowReviewed"],
      "properties": {
        "openApi": { "$ref": "#/$defs/file" },
        "allowedHosts": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$" } },
        "authentication": { "enum": ["none", "oauth"] },
        "privacyPolicyUrl": { "type": "string", "maxLength": 1024, "pattern": "^https://[^\\s@?#]+$" },
        "workspacePolicyReviewed": { "const": true },
        "dataFlowReviewed": { "const": true }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["copilotStudio"],
        "properties": {
          "copilotStudio": {
            "required": ["operation", "solutionType"],
            "properties": {
              "operation": { "const": "import" },
              "solutionType": { "const": "unmanaged" }
            }
          }
        }
      },
      "then": {
        "required": ["environment"],
        "properties": { "environment": { "const": "development" } }
      }
    },
    {
      "if": { "required": ["copilotStudio"] },
      "then": { "properties": { "target": { "const": "copilot-studio" }, "runtime": { "properties": { "kind": { "const": "application" } } }, "rollback": { "properties": { "strategy": { "const": "manual" }, "version": { "type": "null" } } } } }
    },
    {
      "if": { "required": ["agentsToolkit"] },
      "then": { "properties": { "target": { "const": "microsoft-365-agents-toolkit" }, "runtime": { "properties": { "kind": { "const": "application" } } }, "rollback": { "properties": { "strategy": { "const": "manual" }, "version": { "type": "null" } } } } }
    },
    {
      "if": { "required": ["target"], "properties": { "target": { "const": "foundry-endpoint" } } },
      "then": { "properties": { "runtime": { "properties": { "kind": { "enum": ["prompt", "hosted"] } } } } }
    },
    {
      "if": { "required": ["microsoft365"] },
      "then": {
        "properties": {
          "target": { "const": "microsoft-365-copilot-and-teams" },
          "runtime": { "properties": { "kind": { "enum": ["prompt", "hosted"] } } },
          "rollback": { "properties": { "strategy": { "const": "manual" }, "version": { "type": "null" } } }
        }
      }
    },
    {
      "if": {
        "required": ["target", "runtime"],
        "properties": {
          "target": { "const": "foundry-endpoint" },
          "runtime": { "required": ["kind"], "properties": { "kind": { "const": "prompt" } } }
        }
      },
      "then": { "properties": { "foundry": { "required": ["modelDeployment"] } } },
      "else": { "properties": { "foundry": { "not": { "required": ["modelDeployment"] } } } }
    },
    {
      "if": { "properties": { "target": { "const": "foundry-endpoint" } }, "required": ["target"] },
      "then": { "required": ["foundry"] },
      "else": { "not": { "required": ["foundry"] } }
    },
    {
      "if": { "properties": { "target": { "const": "openai-api-application" } }, "required": ["target"] },
      "then": { "required": ["openai"] },
      "else": { "not": { "required": ["openai"] } }
    },
    {
      "if": { "properties": { "target": { "const": "chatgpt-action-handoff" } }, "required": ["target"] },
      "then": { "required": ["chatgpt"] },
      "else": { "not": { "required": ["chatgpt"] } }
    },
    {
      "if": { "properties": { "target": { "const": "foundry-endpoint" }, "runtime": { "properties": { "kind": { "const": "hosted" } }, "required": ["kind"] } }, "required": ["runtime", "target"] },
      "then": { "required": ["hosted"] },
      "else": { "not": { "required": ["hosted"] } }
    },
    {
      "if": { "properties": { "target": { "const": "chatgpt-action-handoff" }, "audience": { "enum": ["link", "gpt-store"] } }, "required": ["target", "audience"] },
      "then": { "properties": { "chatgpt": { "required": ["privacyPolicyUrl"] } } }
    }
  ],
  "$defs": {
